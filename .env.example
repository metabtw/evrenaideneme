# =====================================================================
# EvrenAid — örnek yapılandırma
# Bu dosyayı `.env` olarak kopyalayın ve kendi değerlerinizi girin.
#   Windows : copy .env.example .env
#   macOS/Linux : cp .env.example .env
# `.env` dosyası .gitignore içindedir; gerçek anahtarlar repoya girmez.
# =====================================================================

# --- Uygulama ---
APP_CAMERA_INDEX=0
APP_FRAME_WIDTH=1280
APP_FRAME_HEIGHT=720
APP_TARGET_FPS=30
APP_BACKEND=auto
APP_RECONNECT_ATTEMPTS=3
APP_RECONNECT_DELAY=0.5
APP_MODEL_PATH=yolov8n.pt
APP_CONFIDENCE=0.35
APP_IMG_SIZE=640
APP_IOU=0.45
# auto | cpu | cuda | mps
APP_DEVICE=auto
APP_MAX_DETECTIONS=100
# Boş = tüm COCO sınıfları. Virgülle ayrılmış kimlikler: 0,2,16
APP_CLASSES=
# Sınıf kataloğu (YOLO + CLIP hibrit). Boş = yalnızca YOLO (COCO).
# Örn: datasets/classes.yaml
APP_CATALOG=
# CLIP'in YOLO etiketini geçersiz kılması için gereken güven
APP_CLIP_OVERRIDE=0.45
# CLIP çalışma aralığı (saniye). Çok küçük değer CPU'yu yorar; 0 = her kare (önerilmez).
APP_CLIP_INTERVAL=1.0
APP_TRIGGER_KEY=s
APP_SHOW_FPS=true
APP_HUD_ENABLED=true
APP_WINDOW_NAME=EvrenAid

# --- Vision LLM ---
# ollama            -> yerel, tamamen çevrimdışı (varsayılan)
# openai-compatible -> bulut / uzak sunucu (VLM_API_* gerekir)
VLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llava:7b
VLM_TIMEOUT_SECONDS=120
VLM_MAX_TOKENS=256
VLM_TEMPERATURE=0.2

# --- Bulut sağlayıcı (yalnızca VLM_PROVIDER=openai-compatible ise) ---
# Anahtarı buraya DEĞİL, yalnızca yerel .env dosyanıza yazın.
VLM_API_BASE=
VLM_API_KEY=
VLM_MODEL=

# --- Sesli geri bildirim ---
# auto         -> Windows'ta WinRT (OneCore Türkçe ses), diğerlerinde pyttsx3-proc
# winrt        -> Windows OneCore sesleri (Ayarlar'dan eklenen Türkçe ses: Tolga)
# pyttsx3-proc -> ayrı süreçte pyttsx3 (SAPI5 sesleri)
# pyttsx3      -> aynı süreçte thread | gtts -> internet | none -> sessiz
TTS_ENGINE=auto
TTS_LANGUAGE=tr
TTS_RATE=180
TTS_VOLUME=1.0

# --- Yakınlık / engel uyarısı (giyilebilir) ---
# Kutu yüksekliği / kare yüksekliği oranı. %60 -> kritik uyarı.
SPATIAL_CRITICAL_RATIO=0.60
SPATIAL_NEAR_RATIO=0.35
# Kaç kare üst üste görülünce uyarı verilsin (yanlış alarmı azaltır)
SPATIAL_CONFIRM_FRAMES=3
# Aynı nesne için tekrar uyarı aralığı (saniye)
SPATIAL_COOLDOWN=3.0
# Yalnızca tehlike sınıfları için sesli uyarı
SPATIAL_HAZARD_ONLY=true
# Boş = varsayılan tehlike listesi. Virgülle ayrılmış Türkçe etiketler.
SPATIAL_HAZARD_CLASSES=

# --- Giyilebilir asistan ---
# autopilot | deep
WEARABLE_START_MODE=autopilot
# Gözlük kamerası yan/ters monte edildiyse: 0, 90, 180, 270
WEARABLE_ROTATION=0
WEARABLE_SPEAK_ON_START=true
WEARABLE_SPEAK_ERRORS=true

# --- Loglama ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_CONSOLE=true
